{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "on",
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.csv": "csv"
  },
  "rainbow_csv.enable_auto_csv_lint": true,
  "rainbow_csv.enable_cursor_position_info": true,
  "cSpell.language": "en-US",
  "cSpell.words": [
    "Alpharetta",
    "amenity",
    "amenities",
    "Brookhaven",
    "Buckhead",
    "Calendly",
    "ClassPass",
    "closeout",
    "COO",
    "Duluth",
    "Greystar",
    "Gwinnett",
    "Hatha",
    "HIIT",
    "InMail",
    "Johns Creek",
    "kickoff",
    "lease-up",
    "leaseup",
    "LinkedIn",
    "Midtown",
    "multifamily",
    "Namecheap",
    "one-pager",
    "Pilates",
    "ResideWell",
    "residewell",
    "Sandy Springs",
    "signup",
    "submarket",
    "submarkets",
    "Suwanee",
    "Typeform",
    "Vinyasa",
    "walkthrough",
    "wellness",
    "Zillow"
  ],
  "cSpell.ignorePaths": [
    "node_modules/**",
    ".git/**",
    "crm/target-properties-example.csv"
  ],
  "markdown.extension.toc.levels": "2..4",
  "markdown.extension.preview.breaks": true
}
