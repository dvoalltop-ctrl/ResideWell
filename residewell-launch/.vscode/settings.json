{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.wordWrap": "on",
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[csv]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "files.associations": {
    "*.csv": "csv"
  },
  "rainbow_csv.enable_auto_csv_lint": true,
  "rainbow_csv.enable_cursor_position_info": true,
  "cSpell.language": "en",
  "cSpell.words": [
    "Alpharetta",
    "amenity",
    "Brookhaven",
    "Buckhead",
    "Calendly",
    "checkin",
    "check-in",
    "ClassPass",
    "closeout",
    "COO",
    "counteroffer",
    "Duluth",
    "follow-up",
    "followup",
    "Greystar",
    "Hatha",
    "healthcheck",
    "HIIT",
    "InMail",
    "Johns Creek",
    "kickoff",
    "lease-up",
    "LinkedIn",
    "Midtown",
    "multifamily",
    "northbound",
    "one-pager",
    "Pilates",
    "pre-pilot",
    "ResideWell",
    "residewell",
    "roster",
    "Rooftop",
    "RTY",
    "Sandy Springs",
    "signup",
    "submarket",
    "submarkets",
    "Suwanee",
    "Typeform",
    "unsubscribe",
    "Vinyasa",
    "walkthrough",
    "wellness",
    "Zillow"
  ],
  "cSpell.ignorePaths": [
    "node_modules/**",
    ".git/**",
    "crm/target-properties-example.csv"
  ],
  "markdown.extension.toc.levels": "2..4",
  "markdown.extension.preview.breaks": true
}
